# Copy thành .env.docker ở root rồi chạy:
#   docker compose --env-file .env.docker up --build
# .env.docker đã nằm trong .gitignore — KHÔNG commit. Giá trị dưới đây CHỈ dùng cho dev local.

# Mật khẩu root MySQL trong container (chỉ dev, DB không mở ra ngoài mạng).
MYSQL_ROOT_PASSWORD=root

# DB riêng cho Docker — KHÁC cluvix_crm của bản chạy trên máy host (không chung dữ liệu).
DB_NAME=cluvix_crm_docker

# dev ⇒ CORS phản chiếu mọi Origin, gin debug, TOTP_ENC_KEY không bắt buộc.
APP_ENV=dev
APP_CODE=CluvixCRMDocker

# HMAC secret ký JWT. Giá trị mặc định dưới đây ai cũng biết — NÊN thay bằng chuỗi của riêng bạn:
#   openssl rand -hex 32
TOKEN_SECRET=dev-only-token-secret-change-me

# Mã hoá secret 2FA (TOTP), phải đúng 64 ký tự hex, hoặc để rỗng (secret lưu plaintext, chỉ chấp nhận ở dev).
# Giá trị dưới là mẫu dev — thay bằng: openssl rand -hex 32
TOTP_ENC_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# true = middleware phân quyền chặn thật (403). admin/develop (super) luôn qua.
PERM_ENFORCE=true

# Origin của frontend (chỉ có tác dụng khi APP_ENV=prod) và gốc link tải file export.
CORS_ALLOWED_ORIGINS=http://localhost:14211
DOWNLOAD_URL=http://localhost:14211

# Lưu file upload — mặc định local: ảnh public ở backend/storage/uploads (phục vụ tại /uploads, FE
# proxy về backend), file đính kèm khách hàng ở backend/storage/private (KHÔNG phục vụ static).
# Đổi sang s3/r2: đặt STORAGE_DRIVER + các biến S3_* (xem backend/.env.example — sai/thiếu ⇒ backend
# dừng khởi động).
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE=
# Xem/phát file đính kèm bằng URL ký ngắn hạn (video/audio tua được). STORAGE_SIGNING_KEY: khoá HMAC
# cho driver local — trống + APP_ENV=dev ⇒ khoá dev công khai; APP_ENV=prod BẮT BUỘC (`openssl rand -hex 32`).
# STORAGE_SIGNED_URL_TTL: hạn URL (300 hoặc 5m; trống ⇒ 5 phút; trần 15 phút).
STORAGE_SIGNING_KEY=
STORAGE_SIGNED_URL_TTL=
S3_KEY=
S3_SECRET=
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_CDN=
S3_FOLDER=
S3_PUBLIC_ACL=

# Port trên máy host (đổi nếu bị trùng). Mặc định cố ý lệch port chuẩn để chạy song song bản native.
FRONTEND_HOST_PORT=14211
BACKEND_HOST_PORT=18011
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
