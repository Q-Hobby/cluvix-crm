{
  "name": "cluvix",
  "version": "2.2",
  "license": "AGPL-3.0-only",
  "scripts": {
    "prepare": "husky install",
    "ng": "ng",
    "start": "ng serve --port 4211 --ssl true --ssl-cert ./localhost.pem --ssl-key  ./localhost-key.pem",
    "startLocal": "ng serve -c local --port 4211 --ssl true --ssl-cert ./localhost.pem --ssl-key  ./localhost-key.pem",
    "startLocal:clean": "rm -rf .angular/cache && npm run startLocal",
    "prebuild": "node scripts/inject-version.js",
    "build": "ng build --configuration=production --aot --output-hashing=all",
    "build:cluvix": "node scripts/inject-version.js && ng build --configuration=production,cluvix --aot --output-hashing=all && node scripts/inject-sw-origin.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "bench:customer-detail": "node scripts/bench-customer-detail.mjs",
    "i18n:find": "node scripts/i18n-find.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:dup": "node scripts/i18n-dup-check.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:check:json": "node scripts/i18n-check.mjs --json",
    "i18n:check:verbose": "node scripts/i18n-check.mjs --verbose",
    "perm:audit": "node scripts/perm-audit.mjs",
    "perm:codegen": "node scripts/perm-codegen.mjs",
    "reaction:parity": "node scripts/reaction-parity-check.mjs",
    "breadcrumb:audit": "node scripts/breadcrumb-audit.mjs",
    "breadcrumb:audit:selftest": "node scripts/breadcrumb-audit.mjs --selftest",
    "buildSass": "sass --update src/assets:src/assets --no-source-map",
    "lint": "ng lint",
    "format": "npx prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "lint:check": "npx eslint \"src/**/*.{ts,html}\"",
    "lint:fix-light": "npx eslint \"src/**/*.{ts,html}\" --fix --max-warnings=0",
    "lint:fix-full": "npx eslint \"src/**/*.{ts,html}\" --fix",
    "check:all": "npm run lint:fix-full && tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.3",
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.3",
    "@angular/compiler": "^22.0.3",
    "@angular/core": "^22.0.3",
    "@angular/forms": "^22.0.3",
    "@angular/platform-browser": "^22.0.3",
    "@angular/platform-browser-dynamic": "^22.0.3",
    "@angular/router": "^22.0.3",
    "@angular/service-worker": "^22.0.3",
    "@fullcalendar/angular": "^6.1.15",
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@primeuix/themes": "^3.0.0",
    "chart.js": "4.4.2",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.0",
    "dompurify": "^3.4.1",
    "echarts": "^5.6.0",
    "flag-icons": "7.6.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "ng-qrcode": "^22.0.0",
    "ngx-device-detector": "^11.0.0",
    "ngx-echarts": "^20.0.2",
    "photoswipe": "^5.4.4",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^22.0.0",
    "quill": "^2.0.3",
    "replace-in-file": "^8.3.0",
    "rxjs": "~7.8.2",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.8.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^20.2.0",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^20.2.0",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/build": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.3",
    "@types/dompurify": "^3.0.5",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.19.2",
    "@types/quill": "^2.0.14",
    "@types/serviceworker": "^0.0.152",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "angular-eslint": "^20.2.0",
    "autoprefixer": "^10.4.20",
    "browserslist": "^4.24.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.5.1",
    "postcss": "^8.4.49",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "rxjs": "~7.8.2",
    "@fullcalendar/angular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,js,html,scss,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
